# Prisma database connection URL
DATABASE_URL="postgresql://<username>:<password>@<host>:<port>/<database>?sslmode=require"

# Server port and environment
PORT=5005
NODE_ENV="development"

# Authentication JWT Secrets
JWT_SECRET="<your-jwt-access-secret-key>"
REFRESH_TOKEN_SECRET="<your-jwt-refresh-secret-key>"

# Redis cache and queue configuration (Upstash Redis URL)
REDIS_URL="rediss://default:<password>@<host>:<port>"

# Google Gemini AI Integration
GEMINI_API_KEY="<your-gemini-api-key>"
GEMINI_MODEL="gemini-2.5-flash"

# Cloudinary Integration (Optional: runs in mock mode if empty)
CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"
CLOUDINARY_CLOUD_NAME="<your-cloudinary-cloud-name>"
CLOUDINARY_API_KEY="<your-cloudinary-api-key>"
CLOUDINARY_API_SECRET="<your-cloudinary-api-secret>"
