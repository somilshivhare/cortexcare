# Prisma database connection URL
DATABASE_URL="postgresql://<username>:<password>@<host>:<port>/<database>?sslmode=require"

# Server port and environment
PORT=5005
NODE_ENV="development"

# Authentication JWT Secrets
JWT_SECRET="<your-jwt-access-secret-key>"
REFRESH_TOKEN_SECRET="<your-jwt-refresh-secret-key>"

# Redis cache and queue configuration
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PASSWORD="<your-redis-password-if-applicable>"

# Google Gemini AI Integration
GEMINI_API_KEY="<your-gemini-api-key>"
GEMINI_MODEL="gemini-2.5-flash"

# LiveKit voice-consultation room credentials
LIVEKIT_API_KEY="<your-livekit-api-key>"
LIVEKIT_API_SECRET="<your-livekit-api-secret>"
